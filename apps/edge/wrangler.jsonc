{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fucktyping-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,

  // Serve the Studio SPA and API from one Worker/origin. API and WebSocket paths
  // always execute Worker code; every other path falls back to the SPA.
  "assets": {
    "directory": "../studio/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/health",
      "/auth/*",
      "/transcribe",
      "/forms",
      "/forms/*",
      "/authoring/*"
    ]
  },

  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },

  // Durable Objects: per-session runtime "brain" + per-session authoring agent.
  "durable_objects": {
    "bindings": [
      { "name": "FORM_SESSION", "class_name": "FormSessionDO" },
      { "name": "FORM_AUTHORING", "class_name": "FormAuthoringDO" }
    ]
  },
  // SQLite-backed DO storage (required on the free plan; recommended everywhere).
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["FormSessionDO"] },
    { "tag": "v2", "new_sqlite_classes": ["FormAuthoringDO"] }
  ],

  // Workers AI: Whisper STT for form-creation push-to-talk.
  "ai": { "binding": "AI" },

  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "PUBLIC_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 }
    }
  ],

  "queues": {
    "producers": [
      { "binding": "CALLBACK_QUEUE", "queue": "fucktyping-callbacks" }
    ],
    "consumers": [
      {
        "queue": "fucktyping-callbacks",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "retry_delay": 60,
        "dead_letter_queue": "fucktyping-callbacks-dlq"
      },
      {
        "queue": "fucktyping-callbacks-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5
      }
    ]
  },

  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fucktyping",
      "database_id": "8e652f6b-6712-4b48-9450-ba7651bb8fa4",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    "APP_ENV": "production",
    // Cloudflare-hosted, function-calling model used by authoring and validation.
    "AI_TEXT_MODEL": "@cf/zai-org/glm-4.7-flash"
  },

  // Staging is a separate Worker with isolated Durable Objects and D1 data. Binding
  // configuration is intentionally repeated because Wrangler does not inherit it.
  "env": {
    "staging": {
      "name": "fucktyping-edge-staging",
      "durable_objects": {
        "bindings": [
          { "name": "FORM_SESSION", "class_name": "FormSessionDO" },
          { "name": "FORM_AUTHORING", "class_name": "FormAuthoringDO" }
        ]
      },
      "ai": { "binding": "AI" },
      "ratelimits": [
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "2001",
          "simple": { "limit": 10, "period": 60 }
        },
        {
          "name": "PUBLIC_RATE_LIMITER",
          "namespace_id": "2002",
          "simple": { "limit": 60, "period": 60 }
        }
      ],
      "queues": {
        "producers": [
          { "binding": "CALLBACK_QUEUE", "queue": "fucktyping-callbacks-staging" }
        ],
        "consumers": [
          {
            "queue": "fucktyping-callbacks-staging",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "retry_delay": 60,
            "dead_letter_queue": "fucktyping-callbacks-staging-dlq"
          },
          {
            "queue": "fucktyping-callbacks-staging-dlq",
            "max_batch_size": 10,
            "max_batch_timeout": 5
          }
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "fucktyping-staging",
          "database_id": "3ec19b20-f105-43f5-8b02-c1b1d74e89fa",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "APP_ENV": "staging",
        "AI_TEXT_MODEL": "@cf/zai-org/glm-4.7-flash"
      }
    }
  }
  // Required runtime secrets (do NOT commit): SESSION_SECRET, CREATE_TOKEN,
  // WEBHOOK_SIGNING_SECRET. Configure each environment independently.
}
